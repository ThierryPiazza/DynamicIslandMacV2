<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Richiesto per leggere/inviare eventi AppleScript ad altre app (es. Music, browser) -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Richiesto da Hardened Runtime per accedere al Calendario dell'utente -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Richiesto da Hardened Runtime per accedere alla posizione GPS/Wi-Fi -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
